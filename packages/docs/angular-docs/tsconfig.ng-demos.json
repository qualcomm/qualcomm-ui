{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "outDir": "node_modules/.tmp/ng-demos-out",
    "composite": true,
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo-ng-demos",
    "paths": {
      "@qualcomm-ui/angular/*": ["../../frameworks/angular/src/*/index.ts"],
      "@qualcomm-ui/angular-core/*": [
        "../../frameworks/angular-core/src/*/index.ts"
      ],
      "@qualcomm-ui/core/*": ["../../common/core/dist/*/index.d.ts"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/dist/*/index.d.ts"],
      "@qualcomm-ui/utils/*": ["../../common/utils/dist/*/index.d.ts"],
      "@qualcomm-ui/dom/*": ["../../common/dom/dist/*/index.d.ts"]
    }
  },
  "include": ["./src/routes/**/*/demos"],
  "references": [
    {
      "path": "../../frameworks/angular/tsconfig.lib.json"
    },
    {
      "path": "../../frameworks/angular-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/qds-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ]
}
