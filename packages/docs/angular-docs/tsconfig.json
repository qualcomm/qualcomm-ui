{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.react-docs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "paths": {
      // TODO: remove this once WebStorm fixes symlinks in WSL2
      "@qualcomm-ui/core/*": ["../../common/core/src/*/index.ts"],
      "@qualcomm-ui/dom/*": ["../../common/dom/src/*/index.ts"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/src/*/index.ts"],
      "@qualcomm-ui/react/*": ["../../frameworks/react/src/*/index.ts"],
      "@qualcomm-ui/react-core/*": ["../../frameworks/react-core/src/*/index.ts"]
    }
  },
  "include": ["./src"],
  "exclude": ["./src/routes/**/demos/*.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.ng-demos.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
