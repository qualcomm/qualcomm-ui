{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.react-docs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "paths": {
      "@qualcomm-ui/angular/*": ["../../frameworks/angular/src/*/index.ts"],
      "@qualcomm-ui/angular-core/*": ["../../frameworks/angular-core/src/*/index.ts"],
      // TODO: remove when WebStorm fixes symlinks
      "@qualcomm-ui/mdx-vite/*": ["../../frameworks/mdx-vite/src/*"],
      "@qualcomm-ui/core/*": ["../../common/core/src/*"],
      "@qualcomm-ui/dom/*": ["../../common/core/src/*"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/src/*"],
      "@qualcomm-ui/utils/*": ["../../common/utils/src/*"]
    }
  },
  "include": ["./src"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.ng-demos.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
