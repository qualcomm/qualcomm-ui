{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.react-docs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "composite": true,
    "outDir": "node_modules/.tmp/out",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo",
    "module": "esnext",
    "target": "esnext",
    "types": [
      "node",
      "vite/client",
      "@qualcomm-ui/mdx-vite/docs-plugin",
      "@qualcomm-ui/mdx-vite/angular-demo-plugin"
    ]
  },
  "include": [
    "./src",
  ],
  "exclude": ["./src/routes/**/demos/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/mdx-vite/tsconfig.lib.json"
    },
    {
      "path": "../../common/qds-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    },
  ]
}
