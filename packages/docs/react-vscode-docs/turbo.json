  ],
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        ".typedoc/**"
      ]
    },
    "build:typedoc": {
      "inputs": [
        "qui-typedoc.config.ts",
        "tsconfig.typedoc.json",
