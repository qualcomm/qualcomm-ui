{
  "name": "@qualcomm-ui/react-vscode-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation for the NextGen QUI React VS Code library.",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "type": "module",
  "scripts": {
    "build": "run-s build:typedoc build:site typecheck",
    "build:site": "react-router build --mode production",
    "build:typedoc": "qui-typedoc build",
    "dev": "react-router typegen && vite",
    "watch:typedoc": "qui-typedoc watch",
    "lint": "eslint --quiet",
    "lint-docs": "qui-docs lint",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -b tsconfig.lib.json tsconfig.scripts.json"
  },
  "dependencies": {
    "@mdx-js/react": "catalog:",
    "@qualcomm-ui/mdx-common": "workspace:*",
    "@qualcomm-ui/qds-core": "workspace:*",
    "@qualcomm-ui/react": "workspace:*",
    "@qualcomm-ui/react-core": "workspace:*",
    "@qualcomm-ui/react-internal": "workspace:*",
    "@qualcomm-ui/react-mdx": "workspace:*",
    "@qualcomm-ui/react-router-utils": "workspace:*",
    "@qualcomm-ui/react-vscode": "workspace:*",
    "@qualcomm-ui/tailwind-plugin": "workspace:*",
    "@qualcomm-ui/vscode-core": "workspace:*",
    "isbot": "^5",
    "jotai": "^2.7.1",
    "lucide-react": "0.569.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/rollup": "catalog:",
    "@qualcomm-ui/mdx-vite": "workspace:*",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/typedoc": "workspace:*",
    "@react-router/dev": "catalog:",
    "@react-router/remix-routes-option-adapter": "catalog:",
    "@react-router/serve": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "npm-run-all2": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
