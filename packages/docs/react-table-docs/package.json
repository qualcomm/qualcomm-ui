    "@qualcomm-ui/react-internal": "workspace:*",
    "@qualcomm-ui/dom": "workspace:*",
    "@qualcomm-ui/react-mdx": "workspace:*",
    "@qualcomm-ui/mdx-common": "workspace:*",
    "@qualcomm-ui/node-utils": "workspace:*",
    "@qualcomm-ui/qds-core": "workspace:*",
    "@qualcomm-ui/react": "workspace:*",
    "@qualcomm-ui/react-core": "workspace:*",
    "@qualcomm-ui/react-router-utils": "workspace:*",
    "@qualcomm-ui/tailwind-plugin": "workspace:*",
    "@qualcomm-ui/typedoc": "workspace:*",
    "@qualcomm-ui/utils": "workspace:^*",
    "@react-router/express": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/remix-routes-option-adapter": "catalog:",
    "@react-router/serve": "catalog:",
    "@shikijs/langs": "^3.13.0",
    "@shikijs/themes": "^3.13.0",
    "@tanstack/react-query": "^5.59.16",
