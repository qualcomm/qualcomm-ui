    "postcss": "^8.5.6",
    "rehype-mdx-code-props": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^4.0.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
