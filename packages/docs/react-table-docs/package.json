{
  "name": "@qualcomm-ui/react-table-docs",
  "version": "0.0.0",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s build:typedoc generate-llms-txt build:site",
    "build:site": "react-router build",
    "build:typedoc": "qui-typedoc build",
    "watch:typedoc": "qui-typedoc watch",
    "dev": "run-p dev:app typecheck",
    "dev:app": "react-router typegen && vite -c vite.config.ts",
    "lint": "eslint --quiet",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "tsc -b tsconfig.lib.json -w --preserveWatchOutput",
    "generate-llms-txt": "qui-mdx-vite generate-llms-txt --clean --output-mode aggregated -o public/llms-full.txt --name 'QUI React Table Documentation'",
    "generate-knowledge": "qui-mdx-vite generate-llms-txt --clean --output-mode per-page",
    "upload-knowledge": "qui-mdx-vite upload-knowledge",
    "update-knowledge": "run-s generate-knowledge upload-knowledge"
  },
  "dependencies": {
    "@aws-sdk/client-apprunner": "3.927.0",
    "@aws-sdk/client-route-53": "3.927.0",
    "@dnd-kit/core": "^6.3.1",
