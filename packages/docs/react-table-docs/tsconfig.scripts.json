{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.scripts.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "node_modules/.tmp/scripts-out-tsc",
    "tsBuildInfoFile": "node_modules/.tmp/.tsbuildinfo-scripts",
    "paths": {
      "~components/*": ["./src/components/*"],
      "~utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "./scripts",
    "*.ts"
  ]
}
