{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.lib.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo-lib",
    "paths": {
      "@qualcomm-ui/vscode-core/*": [
        "./src/*/index.ts"
      ]
    }
  },
  "include": [
    "./src"
  ]
}
