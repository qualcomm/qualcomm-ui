{
  "name": "@qualcomm-ui/node-utils",
  "version": "1.0.4",
  "description": "A Node.js utility library",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs",
      "default": "./dist/*/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:ts",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "build:js": "vite build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "dev": "run-p watch:js watch:ts",
    "watch:js": "vite build -w",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish",
    "test": "vitest --run -c vitest.config.ts",
    "test:unit:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads"
  },
  "devDependencies": {
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/vite": "catalog:",
    "@types/node": "catalog:",
    "chalk": "catalog:",
    "chokidar": "catalog:",
    "glob": "catalog:",
    "pretty-ms": "^9.3.0",
    "shx": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
