{
  "name": "@qualcomm-ui/mdx-vite",
  "version": "3.9.1",
  "description": "Vite documentation plugin for applications that use MDX",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "bin": {
    "qui-mdx-vite": "./lib/cli.js"
  },
  "files": [
    "dist",
    "lib"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./angular-demo-plugin": {
      "types": "./dist/angular-demo-plugin/virtual.d.ts"
    },
    "./docs-plugin": {
      "types": "./dist/docs-plugin/virtual.d.ts"
    },
    "./react-demo-plugin": {
      "types": "./dist/react-demo-plugin/virtual.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean compile",
    "compile": "run-s build:js build:types",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "build:js": "vite build",
    "build:types": "tsc -b tsconfig.lib.json",
    "dev": "run-p watch:js watch:types",
    "watch:js": "vite build -w",
    "watch:types": "pnpm build:types -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish",
    "test": "vitest -c vitest.config.ts --run",
    "update-snapshots": "cross-env UPDATE_SNAPSHOTS=true pnpm test",
    "test:ui": "vitest -c vitest.config.ts --ui --coverage.enabled=true",
    "test:coverage": "pnpm test -- --coverage",
    "test:watch": "vitest -c vitest.config.ts",
    "test:unit:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "chalk": "catalog:",
    "chokidar": "catalog:",
    "cosmiconfig": "^9.0.0",
    "es-module-lexer": "^1.7.0",
    "glob": "catalog:",
    "hast-util-from-html": "^2.0.1",
    "hast-util-heading": "^3.0.0",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.0",
    "hast-util-to-text": "^4.0.2",
    "mdast-util-from-markdown": "^2.0.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "pretty-ms": "^9.3.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.0.1",
    "remark-parse": "^11.0.0",
    "remark-parse-frontmatter": "^1.0.3",
    "remark-rehype": "^11.1.0",
    "remark-stringify": "^11.0.0",
    "unified": "catalog:",
    "unist-util-filter": "^5.0.1",
    "unist-util-find": "^3.0.0",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/mdx-common": "workspace:^2.5.0",
    "@qualcomm-ui/tailwind-plugin": "workspace:^1.10.0",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/typedoc-common": "workspace:^1.0.8",
    "@qualcomm-ui/utils": "workspace:^1.3.2",
    "@qualcomm-ui/vite": "catalog:",
    "@types/hast": "^3.0.4",
    "@types/lodash-es": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "hastscript": "^9.0.0",
    "lodash-es": "catalog:",
    "minimatch": "^10.2.5",
    "ora": "^9.0.0",
    "postcss": "catalog:",
    "postcss-selector-parser": "^7.1.1",
    "rehype-mdx-code-props": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^4.0.0",
    "shiki": "catalog:",
    "shx": "catalog:",
    "tailwindcss": "catalog:",
    "test": "^3.3.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@qualcomm-ui/mdx-common": "workspace:^2.5.0",
    "@qualcomm-ui/typedoc-common": "workspace:^1.0.8",
    "@qualcomm-ui/utils": "workspace:^1.3.2",
    "lodash-es": ">=4.17.21 <5",
    "minimatch": ">=10",
    "rehype-mdx-code-props": ">=3 <4",
    "remark-frontmatter": ">=5 <6",
    "remark-gfm": ">=4 <5",
    "remark-mdx-frontmatter": ">=4 <5",
    "shiki": ">=3.7.0",
    "typescript": ">=5.5.4",
    "vite": ">=7 <9",
    "zod": ">=4.1.0"
  },
  "optionalDependencies": {
    "@qualcomm-ui/tailwind-plugin": "workspace:^1.10.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.1",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
