{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.vitest.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "rootDir": "./src",
    "outDir": "node_modules/.cache/tsc/out-spec",
    "tsBuildInfoFile": "node_modules/.cache/tsc/.tsbuildinfo-spec"
  },
  "include": ["./src/**/*.spec.ts", "./src/**/__tests__/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
