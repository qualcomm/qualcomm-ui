{
  "name": "@qualcomm-ui/codemod",
  "version": "1.1.0",
  "description": "Codemod utilities for automatic QUI package migrations",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui-utils",
  "bin": {
    "qui-codemod": "./lib/cli.cjs"
  },
  "files": [
    "dist",
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:ts",
    "clean": "shx rm -rf dist node_modules/.tmp",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b --force",
    "dev": "run-p watch:js watch:ts",
    "watch:js": "tsx build.ts --watch",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "test": "vitest -c vitest.config.ts --run",
    "test:ui": "vitest -c vitest.config.ts --ui --coverage.enabled=true",
    "test:coverage": "pnpm test -- --coverage",
    "test:watch": "vitest -c vitest.config.ts",
    "test:unit:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@qualcomm-ui/cli": "workspace:*",
    "@qualcomm-ui/esbuild": "workspace:*",
    "@qualcomm-ui/tsconfig": "workspace:*",
    "@types/node": "~24.10.13",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "esbuild": "catalog:",
    "glob": "catalog:",
    "npm-run-all2": "^8.0.4",
    "semver": "^7.8.1",
    "shx": "^0.4.0",
    "ts-morph": "^25.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@qualcomm-ui/utils": "^1.1.0"
  }
}
