{
  "name": "@qualcomm-ui/qds-core",
  "version": "1.33.2",
  "description": "qds core components",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs",
      "default": "./dist/*/index.js"
    },
    "./themes/*-dark.css": {
      "import": "./dist/*-dark.min.css",
      "style": "./dist/*-dark.min.css",
      "default": "./dist/*-dark.min.css"
    },
    "./themes/*-light.css": {
      "import": "./dist/*-light.min.css",
      "style": "./dist/*-light.min.css",
      "default": "./dist/*-light.min.css"
    },
    "./themes/*-typography.css": {
      "import": "./dist/*-typography.min.css",
      "style": "./dist/*-typography.min.css",
      "default": "./dist/*-typography.min.css"
    },
    "./styles/components.css": {
      "import": "./dist/components.min.css",
      "style": "./dist/components.min.css",
      "default": "./dist/components.min.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:css build:ts",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "build:js": "vite build",
    "build:css": "qui-css-utils build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "dev": "run-p watch:js watch:css watch:ts",
    "watch:js": "vite build -w",
    "watch:css": "qui-css-utils watch",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish",
    "update-design-tokens": "tsx scripts/token-builder.ts"
  },
  "devDependencies": {
    "@figma/rest-api-spec": "^0.31.0",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/core": "workspace:^1.11.7",
    "@qualcomm-ui/css-utils": "catalog:",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/utils": "workspace:^1.3.2",
    "@qualcomm-ui/vite": "catalog:",
    "@types/culori": "^4.0.0",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "culori": "^4.0.1",
    "dotenv": "^17.2.3",
    "figma-api": "^2.0.2-beta",
    "json5": "^2.2.3",
    "lodash-es": "catalog:",
    "postcss": "catalog:",
    "postcss-nested": "^7.0.2",
    "postcss-selector-parser": "^7.1.1",
    "shx": "catalog:",
    "style-dictionary": "^5.4.4",
    "style-dictionary-utils": "~4.1.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@qualcomm-ui/core": "workspace:^1.11.7",
    "@qualcomm-ui/utils": "workspace:^1.3.2"
  }
}
