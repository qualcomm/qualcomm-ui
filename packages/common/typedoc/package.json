{
  "name": "@qualcomm-ui/typedoc",
  "version": "1.1.7",
  "description": "Documentation generation utilities",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "bin": {
    "qui-typedoc": "./lib/cli.js"
  },
  "files": [
    "dist",
    "lib"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:ts",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "build:js": "vite build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "dev": "run-p watch:js watch:ts",
    "watch:js": "vite build -w",
    "watch:ts": "tsc -b tsconfig.lib.json -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "test": "vitest -c vitest.config.ts --run",
    "test:ui": "vitest -c vitest.config.ts --ui --coverage.enabled=true",
    "test:coverage": "pnpm test -- --coverage",
    "test:watch": "vitest -c vitest.config.ts",
    "test:unit:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads",
    "build:cli": "run-s clean compile",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "dependencies": {},
  "devDependencies": {
    "@angular/core": "catalog:",
    "@clack/prompts": "1.0.0-alpha.6",
    "@commander-js/extra-typings": "catalog:",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/typedoc-common": "workspace:^1.0.8",
    "@types/lodash-es": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "chalk": "catalog:",
    "chokidar": "catalog:",
    "cosmiconfig": "^9.0.0",
    "inquirer": "^12.1.0",
    "lodash-es": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "shx": "catalog:",
    "terminate": "^2.6.1",
    "tsx": "catalog:",
    "typedoc": "~0.28.19",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@commander-js/extra-typings": ">=13.1.0",
    "@qualcomm-ui/typedoc-common": "workspace:^1.0.8",
    "@qualcomm-ui/vite": "catalog:",
    "cosmiconfig": ">=9.0.0",
    "oxfmt": ">=0.51.0",
    "typedoc": ">=0.28.4",
    "typescript": ">=5.3.3 <7"
  },
  "engines": {
    "node": ">=20"
  }
}
