{
  "name": "@qualcomm-ui/tailwind-plugin",
  "version": "1.10.0",
  "description": "Qualcomm UI Tailwind Plugin",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./vscode": {
      "types": "./dist/vscode/index.d.ts",
      "import": "./dist/vscode/index.js",
      "default": "./dist/vscode/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./qui.css": {
      "style": "./dist/qui.css",
      "default": "./dist/qui.css"
    },
    "./qui-strict.css": {
      "style": "./dist/qui-strict.css",
      "default": "./dist/qui-strict.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean generate-css build:js build:ts build:css",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "generate-css": "tsx scripts/generate-nextgen-plugin.ts",
    "build:js": "vite build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "build:css": "qui-css-utils build",
    "dev": "run-p watch:js watch:ts watch:css",
    "watch:js": "vite build -w",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "watch:css": "qui-css-utils watch",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish",
    "generate-tailwind-knowledge": "pnpm tsx scripts/variables-to-text.ts src/qui.css ./generated/tailwind-qui-next-gen.txt"
  },
  "devDependencies": {
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/css-utils": "catalog:",
    "@qualcomm-ui/qds-core": "workspace:^1.37.0",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/vite": "catalog:",
    "shx": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": ">=4"
  }
}
