{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.lib.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo-lib",
    "paths": {
      "@qualcomm-ui/react-vscode/*": [
        "./src/*/index.ts"
      ]
    }
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "./src/**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "../react-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    },
    {
      "path": "../../common/vscode-core/tsconfig.lib.json"
    }
  ]
}
