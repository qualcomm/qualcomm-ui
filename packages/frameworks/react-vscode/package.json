{
  "name": "@qualcomm-ui/react-vscode",
  "version": "0.0.0",
  "description": "VS Code components built on design-agnostic QUI React primitives.",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles/index.js"
  ],
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:ts",
    "build:js": "vite build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "dev": "run-p watch:js watch:ts",
    "lint": "eslint --quiet",
    "test": "vitest --run",
    "test:watch": "vitest",
    "watch:js": "vite build -w",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput"
  },
  "devDependencies": {
    "@qualcomm-ui/core": "workspace:^1.15.0",
    "@qualcomm-ui/dom": "workspace:^1.3.3",
    "@qualcomm-ui/react-core": "workspace:^1.11.0",
    "@qualcomm-ui/react-test-utils": "workspace:^1.0.6",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/utils": "workspace:^1.6.0",
    "@qualcomm-ui/vite": "catalog:",
    "@qualcomm-ui/vscode-core": "workspace:^0.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "npm-run-all2": "catalog:",
    "react": "catalog:",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "catalog:",
    "shx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.0.2"
  },
  "peerDependencies": {
    "@qualcomm-ui/core": "workspace:^1.15.0",
    "@qualcomm-ui/dom": "workspace:^1.3.3",
    "@qualcomm-ui/react-core": "workspace:^1.11.0",
    "@qualcomm-ui/utils": "workspace:^1.6.0",
    "@qualcomm-ui/vscode-core": "workspace:^0.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
