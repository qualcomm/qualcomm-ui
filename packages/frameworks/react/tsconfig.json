{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "paths": {
      // fixes WebStorm usage detection, not used otherwise
      "@qualcomm-ui/react/*": ["./src/*/index.ts"],
      "~test-utils/runner": ["./test-utils/runner.ts"],
      // TODO: remove this once WebStorm fixes symlinks in WSL2
      "@qualcomm-ui/core/*": ["../../common/core/src/*/index.ts"],
      "@qualcomm-ui/dom/*": ["../../common/dom/src/*/index.ts"],
      "@qualcomm-ui/qds-core/*": ["../../common/qds-core/src/*/index.ts"],
      "@qualcomm-ui/react-core/*": ["../react-core/src/*/index.ts"]
    }
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.figma.tsx"],
  "references": [
    {
      "path": "./tsconfig.figma.json"
    },
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "../react-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/qds-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ]
}
