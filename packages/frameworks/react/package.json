{
  "name": "@qualcomm-ui/react",
  "version": "1.20.3",
  "description": "QUI React components",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "run-s clean build:js build:ts",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b tsconfig.lib.json",
    "clean": "shx rm -rf dist/tsbuildinfo dist/**/*.js dist/**/*.cjs dist/**/*.mjs dist/**/*.js.map",
    "dev": "run-p watch:js watch:ts",
    "lint": "eslint --quiet",
    "postpublish": "qui-cli post-publish",
    "prepublishOnly": "qui-cli pre-publish",
    "test": "vitest -c vitest.config.ts --run",
    "test:coverage": "vitest -c vitest.config.ts --run --coverage",
    "test:react:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=forks --no-file-parallelism",
    "test:watch": "cross-env vitest -c vitest.config.ts",
    "watch:js": "tsx build.ts --watch --mode development",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "code-connect": "tsx scripts/code-connect/cli.ts",
    "figma:publish-components": "figma connect publish -c figma/components.config.json",
    "figma:publish-icons": "figma connect publish -c figma/icons.config.json --batch-size 500"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@commander-js/extra-typings": "^14.0.0",
    "@figma/code-connect": "^1.4.2",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/core": "workspace:^1.9.0",
    "@qualcomm-ui/dom": "workspace:^1.1.0",
    "@qualcomm-ui/esbuild": "catalog:",
    "@qualcomm-ui/qds-core": "workspace:^1.26.1",
    "@qualcomm-ui/react-core": "workspace:^1.4.3",
    "@qualcomm-ui/react-test-utils": "workspace:^1.0.1",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/utils": "workspace:^1.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/babel__core": "^7.20.5",
    "@types/lodash-es": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-transition-group": "^4.4.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "commander": "^14.0.2",
    "esbuild": "catalog:",
    "lodash-es": "catalog:",
    "lucide-react": "0.569.0",
    "playwright": "1.56.1",
    "quick-lru": "^7.2.0",
    "react": "catalog:",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "catalog:",
    "rollup-plugin-visualizer": "^5.12.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.17",
    "tsx": "catalog:",
    "typescript-plugin-css-modules": "^5.0.1",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.0.2"
  },
  "peerDependencies": {
    "@qualcomm-ui/core": "workspace:^1.9.0",
    "@qualcomm-ui/qds-core": "workspace:^1.26.1",
    "@qualcomm-ui/react-core": "workspace:^1.4.3",
    "@qualcomm-ui/utils": "workspace:^1.2.3",
    "@tanstack/react-virtual": ">=3.13.9",
    "lucide-react": ">=0.483.0 <2",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "nyc": {
    "reporter": [
      "cobertura",
      "html"
    ],
    "extension": [
      ".js",
      ".cjs",
      ".mjs",
      ".ts",
      ".tsx"
    ]
  }
}
