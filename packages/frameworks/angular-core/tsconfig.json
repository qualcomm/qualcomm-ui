{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.angular-lib-strict.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "paths": {
      // fixes WebStorm usage detection, not used otherwise
      "@qualcomm-ui/angular-core/*": ["./src/*/index.ts"],
    }
  },
  "exclude": ["./src/**/*.spec.ts"],
  "references": [
    {
      "path": "./tsconfig.angular-lib.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/tailwind-plugin/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ]
}
