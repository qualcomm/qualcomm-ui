{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.angular-lib-strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsbuildinfo",
    "composite": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      // this is only for dev intellisense.
      "@qualcomm-ui/angular-core/*": ["./src/*"]
    }
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/tailwind-plugin/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ],
  "angularCompilerOptions": {
    "flatModuleId": "qui-angular-core",
    "flatModuleOutFile": "qui-angular-core.js"
  }
}
