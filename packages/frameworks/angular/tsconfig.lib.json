{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.angular-lib-strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo-angular-lib",
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      "@qualcomm-ui/angular/*": ["./src/*/index.ts"],
      "@qualcomm-ui/angular-core/*": ["../angular-core/src/*/index.ts"]
    }
  },
  "include": ["./src"],
  "exclude": ["**/*.spec.ts", "**/*.figma.ts"],
  "references": [
    {
      "path": "../angular-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/qds-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ]
}
