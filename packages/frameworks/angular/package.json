{
  "name": "@qualcomm-ui/angular",
  "version": "2.3.0",
  "description": "QUI Angular Components",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/types/qualcomm-ui-angular-*.d.ts",
      "import": "./dist/fesm2022/qualcomm-ui-angular-*.mjs",
      "default": "./dist/fesm2022/qualcomm-ui-angular-*.mjs"
    }
  },
  "scripts": {
    "ng": "ng",
    "build": "ng-packagr -p src/ng-package.json -c tsconfig.lib.json",
    "dev": "node --import=tsx dev.ts",
    "lint": "eslint --quiet",
    "test": "vitest --run --pool=forks",
    "test:coverage": "vitest --run --coverage --pool=forks",
    "test:angular:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=forks --no-file-parallelism",
    "test:ui": "vitest --ui --pool=forks",
    "build:bundle-size": "ng build test-bundle-size-app",
    "analyze-bundle": "source-map-explorer bundle-size-dist/main.js",
    "explore-bundle": "run-s build:bundle-size analyze-bundle",
    "publish-angular-package": "tsx apply-package && qui-cli publish-angular qui-angular",
    "figma:publish-components": "figma connect publish -c figma/components.config.json && figma connect publish -c figma/components-ts.config.json",
    "figma:publish-icons": "figma connect publish -c figma/icons.config.json --batch-size 500"
  },
  "devDependencies": {
    "@analogjs/platform": "catalog:",
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular/animations": "catalog:",
    "@angular/build": "catalog:",
    "@angular-devkit/architect": "catalog:",
    "@angular-devkit/build-angular": "catalog:",
    "@angular-devkit/core": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/cdk-experimental": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-browser-dynamic": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/router": "catalog:",
    "@angular/ssr": "catalog:",
    "@faker-js/faker": "~9.6.0",
    "@floating-ui/dom": "^1.7.0",
    "@figma/code-connect": "^1.4.2",
    "@jsdevtools/coverage-istanbul-loader": "~3.0.5",
    "@module-federation/enhanced": "0.21.2",
    "@qualcomm-ui/angular-core": "workspace:^2.1.0",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/core": "workspace:^1.7.0",
    "@qualcomm-ui/dom": "workspace:^1.0.11",
    "@qualcomm-ui/qds-core": "workspace:^1.23.0",
    "@qualcomm-ui/tailwind-plugin": "workspace:^1.7.0",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/utils": "workspace:^1.2.2",
    "@tanstack/virtual-core": "^3.13.12",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/angular": "^19.1.0",
    "@types/mocha": "^10.0.10",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "chokidar": "^5.0.0",
    "execa": "^9.6.0",
    "js-yaml": "^3.14.2",
    "lucide-angular": "0.569.0",
    "ng-packagr": "catalog:",
    "playwright": "1.56.1",
    "postcss": "^8.5.6",
    "resize-observer-polyfill": "^1.5.1",
    "rxjs": "~7.8.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "tslib": "~2.5.3",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@angular/cdk": ">=21.2 <23",
    "@angular/common": ">=21.2 <23",
    "@angular/compiler": ">=21.2 <23",
    "@angular/core": ">=21.2 <23",
    "@angular/forms": ">=21.2 <23",
    "@angular/platform-browser": ">=21.2 <23",
    "@angular/platform-browser-dynamic": ">=21.2 <23",
    "@qualcomm-ui/angular-core": "workspace:^2.1.0",
    "@qualcomm-ui/core": "workspace:^1.7.0",
    "@qualcomm-ui/qds-core": "workspace:^1.23.0",
    "@qualcomm-ui/utils": "workspace:^1.2.2",
    "@tanstack/virtual-core": ">=3.13.12",
    "lucide-angular": ">=0.569.0 <1",
    "typescript": ">=5.9.3 <7"
  },
  "nyc": {
    "reporter": [
      "cobertura",
      "html"
    ],
    "extension": [
      ".js",
      ".cjs",
      ".mjs",
      ".ts"
    ]
  }
}
