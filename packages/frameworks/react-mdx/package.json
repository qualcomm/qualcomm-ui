{
  "name": "@qualcomm-ui/react-mdx",
  "version": "2.11.4",
  "description": "React components and utilities for MDX documentation sites based on QUI Docs",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./styles.css": {
      "style": "./dist/all.min.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:css build:ts",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "build:js": "vite build",
    "build:css": "qui-css-utils build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "dev": "run-p watch:js watch:css watch:ts",
    "watch:js": "vite build -w",
    "watch:css": "qui-css-utils watch",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "test": "vitest -c vitest.config.ts --run",
    "test:coverage": "vitest -c vitest.config.ts --run --coverage",
    "test:mdx-docs:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=forks --no-file-parallelism",
    "test:watch": "cross-env vitest -c vitest.config.ts --ui --coverage --coverage.enabled=true",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "dependencies": {
    "markdown-to-jsx": "^7.4.7",
    "quick-lru": "^7.2.0"
  },
  "devDependencies": {
    "@mdx-js/react": "catalog:",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/core": "workspace:^1.11.7",
    "@qualcomm-ui/css-utils": "catalog:",
    "@qualcomm-ui/dom": "workspace:^1.1.5",
    "@qualcomm-ui/mdx-common": "workspace:^2.5.0",
    "@qualcomm-ui/qds-core": "workspace:^1.35.0",
    "@qualcomm-ui/react": "workspace:^1.27.4",
    "@qualcomm-ui/react-core": "workspace:^1.5.9",
    "@qualcomm-ui/react-test-utils": "workspace:^1.0.5",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/typedoc-common": "workspace:^1.0.8",
    "@qualcomm-ui/utils": "workspace:^1.3.2",
    "@qualcomm-ui/vite": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@shikijs/langs": "^3.13.0",
    "@shikijs/themes": "^3.13.0",
    "@types/lodash-es": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fuzzysort": "^3.0.1",
    "lodash-es": "catalog:",
    "lucide-react": "0.569.0",
    "playwright": "^1.60.0",
    "quick-lru": "^7.2.0",
    "react": "catalog:",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "catalog:",
    "react-shiki": "catalog:",
    "rollup-plugin-visualizer": "^5.12.0",
    "shiki": "catalog:",
    "shx": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.0.2"
  },
  "peerDependencies": {
    "@floating-ui/react": ">=0.26.9 <1",
    "@mdx-js/react": ">=3.0.1 <4",
    "@qualcomm-ui/core": "workspace:^1.11.7",
    "@qualcomm-ui/mdx-common": "workspace:^2.5.0",
    "@qualcomm-ui/react": "workspace:^1.27.4",
    "@qualcomm-ui/react-core": "workspace:^1.5.9",
    "@qualcomm-ui/utils": "workspace:^1.3.2",
    "@shikijs/langs": ">=3.13.0",
    "@shikijs/themes": ">=3.13.0",
    "fuzzysort": ">=3 <4",
    "lodash-es": ">=4.17.21 <5",
    "lucide-react": ">=0.483.0 <2",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-shiki": ">=0.8.0",
    "react-simple-code-editor": ">=0.14.1",
    "shiki": ">=3.13.0",
    "sucrase": ">=3.35.0"
  },
  "optionalDependencies": {
    "my-ua-parser": "^2.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
