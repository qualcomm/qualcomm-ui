{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.lib.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo-lib",
    "paths": {
      "@qualcomm-ui/react-mdx/*": ["./src/*/index.ts"]
    }
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.spec.tsx"],
  "references": [
    {
      "path": "../react/tsconfig.lib.json"
    },
    {
      "path": "../react-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/dom/tsconfig.lib.json"
    },
    {
      "path": "../../common/mdx-common/tsconfig.lib.json"
    },
    {
      "path": "../../common/mdx-vite/tsconfig.lib.json"
    },
    {
      "path": "../../common/qds-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/typedoc-common/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ]
}
