{
  "name": "@qualcomm-ui/react-open-api",
  "sideEffects": false,
  "version": "0.0.1",
  "description": "React Open API UI components based on scalar",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "style": "./dist/all.min.css",
      "default": "./dist/all.min.css"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-s clean build:js build:ts build:css",
    "clean": "shx rm -rf node_modules/.tmp/tsbuildinfo dist/**/*.js dist/**/*.cjs dist/**/*.mjs dist/**/*.js.map dist/all.min.css",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b tsconfig.lib.json",
    "build:css": "qui-css-utils build",
    "dev": "run-p watch:js watch:ts watch:css",
    "watch:js": "tsx build.ts --watch --mode development",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "watch:css": "qui-css-utils watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "dependencies": {
    "@scalar/openapi-types": "^0.5.2",
    "@scalar/types": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "esbuild": "^0.25.8",
    "@floating-ui/react": "^0.27.3",
    "@qualcomm-ui/css-utils": "workspace:*",
    "@qualcomm-ui/cli": "workspace:^1.0.5",
    "@qualcomm-ui/core": "workspace:^1.0.11",
    "@qualcomm-ui/dom": "workspace:^1.0.6",
    "@qualcomm-ui/esbuild": "workspace:^1.0.4",
    "@qualcomm-ui/qds-core": "workspace:^1.9.3",
    "@qualcomm-ui/react": "workspace:^1.5.0",
    "@qualcomm-ui/react-core": "workspace:^1.0.11",
    "@qualcomm-ui/react-test-utils": "workspace:^1.0.0",
    "@qualcomm-ui/tsconfig": "workspace:^1.0.4",
    "@qualcomm-ui/utils": "workspace:^1.0.4",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/babel__core": "^7.20.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser": "^4.0.8",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "lucide-react": "0.525.0",
    "playwright": "1.56.1",
    "react": "catalog:",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "catalog:",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "vite": "npm:rolldown-vite@7.2.10",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.8",
    "vitest-browser-react": "^2.0.2"
  },
  "peerDependencies": {
    "@qualcomm-ui/core": "workspace:^1.0.11",
    "@qualcomm-ui/dom": "workspace:^1.0.6",
    "@qualcomm-ui/utils": "workspace:^1.0.4",
    "@tanstack/react-virtual": ">=3.13.9",
    "lucide-react": ">=0.379.0 <1",
    "react": ">=19.2.1",
    "react-dom": ">=19.2.1"
  },
  "nyc": {
    "reporter": [
      "cobertura",
      "html"
    ],
    "extension": [
      ".js",
      ".cjs",
      ".mjs",
      ".ts",
      ".tsx"
    ]
  }
}
