{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["dom-navigation"],
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo",
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.spec.tsx"],
  "references": [
    {
      "path": "../react/tsconfig.lib.json"
    },
    {
      "path": "../react-core/tsconfig.lib.json"
    },
    {
      "path": "../react-mdx/tsconfig.lib.json"
    },
    {
      "path": "../../common/core/tsconfig.lib.json"
    },
    {
      "path": "../../common/qds-core/tsconfig.lib.json"
    },
    {
      "path": "../../common/utils/tsconfig.lib.json"
    }
  ]
}
