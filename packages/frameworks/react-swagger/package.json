{
  "name": "@qualcomm-ui/react-swagger",
  "version": "1.2.8",
  "description": "Swagger component replacements using QUI React",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "style": "./dist/all.min.css",
      "default": "./dist/all.min.css"
    }
  },
  "scripts": {
    "build": "run-s clean build:js build:ts build:css",
    "build:css": "qui-css-utils build",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b tsconfig.lib.json",
    "clean": "shx rm -rf node_modules/.tmp/tsbuildinfo dist/**/*.js dist/**/*.cjs dist/**/*.mjs dist/**/*.js.map dist/all.min.css",
    "dev": "run-p watch:js watch:ts watch:css",
    "lint": "eslint --quiet",
    "postpublish": "qui-cli post-publish",
    "prepublishOnly": "qui-cli pre-publish",
    "watch:css": "qui-css-utils watch",
    "watch:js": "tsx build.ts --watch --mode development",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/core": "workspace:^1.4.0",
    "@qualcomm-ui/css-utils": "catalog:",
    "@qualcomm-ui/esbuild": "catalog:",
    "@qualcomm-ui/qds-core": "workspace:^1.20.0",
    "@qualcomm-ui/react": "workspace:^1.15.0",
    "@qualcomm-ui/react-core": "workspace:^1.3.0",
    "@qualcomm-ui/react-mdx": "workspace:^1.13.2",
    "@qualcomm-ui/react-test-utils": "workspace:^1.0.0",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/utils": "workspace:^1.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/babel__core": "^7.20.5",
    "@types/css.escape": "^1.5.2",
    "@types/dom-navigation": "^1.0.6",
    "@types/immutable": "^3",
    "@types/lodash-es": "catalog:",
    "@types/randombytes": "^2.0.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-transition-group": "^4.4.6",
    "@types/sha.js": "^2.4.4",
    "@types/swagger-ui": "^5.21.1",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/url-parse": "^1.4.11",
    "@uiw/codemirror-extensions-langs": "^4.25.3",
    "@uiw/codemirror-theme-github": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "@vitest/browser": "^4.0.8",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "css.escape": "^1.5.1",
    "esbuild": "^0.25.8",
    "immutable": "^3.8.2",
    "lodash-es": "catalog:",
    "lucide-react": "0.525.0",
    "playwright": "1.56.1",
    "quick-lru": "^7.2.0",
    "randombytes": "^2.1.0",
    "react": "catalog:",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "catalog:",
    "sha.js": "^2.4.12",
    "shx": "^0.4.0",
    "swagger-ui": "^5.30.3",
    "swagger-ui-react": "^5.30.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript-plugin-css-modules": "^5.0.1",
    "url-parse": "^1.5.10",
    "vite": "npm:rolldown-vite@7.2.10",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^4.5.2"
  },
  "peerDependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "@qualcomm-ui/core": "workspace:^1.4.0",
    "@qualcomm-ui/qds-core": "workspace:^1.20.0",
    "@qualcomm-ui/react-core": "workspace:^1.3.0",
    "@qualcomm-ui/utils": "workspace:^1.1.0",
    "@tanstack/react-virtual": ">=3.13.9",
    "@uiw/codemirror-extensions-langs": "^4.25.3",
    "@uiw/codemirror-theme-github": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "css.escape": "^1.5.1",
    "immutable": "^3.8.2",
    "lodash-es": "^4.17.21",
    "lucide-react": ">=0.483.0 <2",
    "randombytes": "^2.1.0",
    "react": ">=19.2.1",
    "react-dom": ">=19.2.1",
    "sha.js": "^2.4.12",
    "swagger-ui": "^5.30.3",
    "swagger-ui-react": "^5.30.3",
    "url-parse": "^1.5.10",
    "zustand": ">=4.5.2"
  }
}
