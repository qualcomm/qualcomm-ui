    "lucide-react": "0.569.0",
    "playwright": "^1.60.0",
    "quick-lru": "^7.2.0",
    "randombytes": "^2.1.0",
    "react": "catalog:",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "catalog:",
    "sha.js": "^2.4.12",
    "shx": "catalog:",
    "swagger-ui": "^5.32.1",
