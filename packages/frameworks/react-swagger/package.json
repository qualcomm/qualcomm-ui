{
  "name": "@qualcomm-ui/react-swagger",
  "version": "1.3.27",
  "description": "Swagger component replacements using QUI React",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "style": "./dist/all.min.css",
      "default": "./dist/all.min.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:js build:ts build:css",
    "build:css": "qui-css-utils build",
    "build:js": "vite build",
    "build:ts": "tsc -b tsconfig.lib.json",
    "clean": "shx rm -rf node_modules/.tmp dist",
    "dev": "run-p watch:js watch:ts watch:css",
    "lint": "eslint --quiet",
    "postpublish": "qui-cli post-publish",
    "prepublishOnly": "qui-cli pre-publish",
    "watch:css": "qui-css-utils watch",
    "watch:js": "vite build -w",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/core": "workspace:^1.11.7",
    "@qualcomm-ui/css-utils": "catalog:",
    "@qualcomm-ui/qds-core": "workspace:^1.34.0",
    "@qualcomm-ui/react": "workspace:^1.27.3",
    "@qualcomm-ui/react-core": "workspace:^1.5.9",
    "@qualcomm-ui/react-mdx": "workspace:^2.11.3",
    "@qualcomm-ui/react-test-utils": "workspace:^1.0.5",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@qualcomm-ui/utils": "workspace:^1.3.2",
    "@qualcomm-ui/vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/babel__core": "^7.20.5",
    "@types/css.escape": "^1.5.2",
    "@types/dom-navigation": "^1.0.6",
    "@types/immutable": "^3",
    "@types/lodash-es": "catalog:",
    "@types/randombytes": "^2.0.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-transition-group": "^4.4.6",
    "@types/sha.js": "^2.4.4",
    "@types/swagger-ui": "^5.21.1",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/url-parse": "^1.4.11",
