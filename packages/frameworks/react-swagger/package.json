    "@uiw/codemirror-theme-github": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "css.escape": "^1.5.1",
    "immutable": "^3.8.2",
