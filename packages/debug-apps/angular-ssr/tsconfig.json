{
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "../..",
    "strict": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@qualcomm-ui/angular/*": ["../../frameworks/angular/src/*/index.ts"],
      "@qualcomm-ui/angular-core/*": ["../../frameworks/angular-core/src/*/index.ts"],
      "@qualcomm-ui/angular-docs/*": ["../../docs/angular-docs/src/routes/*"]
    }
  },
  "references": [
    {
      "path": "../../frameworks/angular/tsconfig.lib.json"
    },
    {
      "path": "../../frameworks/angular-core/tsconfig.lib.json"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
}
