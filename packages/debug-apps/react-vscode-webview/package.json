{
  "name": "@qualcomm-ui/react-vscode-webview",
  "displayName": "QUI React VS Code Webview Sample",
  "description": "React/Vite webview integration example for the NextGen QUI VS Code library.",
  "version": "0.0.0",
  "publisher": "qualcomm-ui",
  "private": true,
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "quiReactVscode.openSample",
        "title": "QUI VS Code: Open React Sample"
      }
    ]
  },
  "scripts": {
    "build": "run-s typecheck build:extension build:webview",
    "build:extension": "tsx scripts/build-extension.ts",
    "build:webview": "vite build",
    "dev": "vite",
    "lint": "eslint --quiet",
    "test": "run-s test:protocol test:integration",
    "test:protocol": "node --import tsx --test src/shared/messages.test.ts",
    "test:integration": "tsx scripts/verify-webview.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.extension.json && tsc -p tsconfig.scripts.json",
    "vscode:prepublish": "pnpm build"
  },
  "dependencies": {
    "@qualcomm-ui/core": "workspace:*",
    "@qualcomm-ui/dom": "workspace:*",
    "@qualcomm-ui/react-core": "workspace:*",
    "@qualcomm-ui/react-vscode": "workspace:*",
    "@qualcomm-ui/utils": "workspace:*",
    "@qualcomm-ui/vscode-core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@qualcomm-ui/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "1.95.0",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "npm-run-all2": "catalog:",
    "playwright": "^1.60.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
