{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.vitest.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "rootDir": "./tests",
    "strictPropertyInitialization": false,
    "outDir": "node_modules/.tmp/spec-out-tsc",
    "tsBuildInfoFile": "node_modules/.tmp/.tsbuildinfo-spec",
    "paths": {
      "~data/*": [
        "./tests/src/data/*"
      ],
      "~entities/*": [
        "./tests/src/entities/*"
      ],
      "~features/*": [
        "./tests/src/features/*"
      ],
      "~pages/*": [
        "./tests/src/pages/*"
      ],
      "~shared/*": [
        "./tests/src/shared/*"
      ],
      "~widgets/*": [
        "./tests/src/widgets/*"
      ]
    }
  },
  "include": ["./tests"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
