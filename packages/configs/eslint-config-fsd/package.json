{
  "name": "@qualcomm-ui/eslint-config-fsd",
  "version": "2.0.0",
  "description": "QUI ESLint config for feature-sliced design",
  "keywords": [
    "config",
    "eslint",
    "fsd"
  ],
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "shx rm -rf dist node_modules/.tmp",
    "build": "pnpm clean && pnpm compile",
    "compile": "tsc -b tsconfig.lib.json",
    "test": "vitest -c vitest.config.ts --run",
    "test:unit:ci": "cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads",
    "test:watch": "vitest -c vitest.config.ts",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "devDependencies": {
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/tsconfig": "catalog:",
    "@typescript-eslint/rule-tester": "catalog:",
    "cross-env": "^10.1.0",
    "eslint-plugin-boundaries": "^7.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=9.37.0",
    "eslint-plugin-boundaries": ">=7.0.1 <8",
    "typescript": ">=6.0.3 <7",
    "typescript-eslint": ">=8.67.0"
  }
}
