{
  "name": "@qualcomm-ui/root",
  "version": "0.0.0",
  "description": "@qui monorepo",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "clean-tsbuildinfo": "shx rm -rf packages/*/*/dist/tsbuildinfo packages/*/*/node_modules/.tmp/tsbuildinfo",
    "force-clean": "shx rm -rf packages/*/*/dist",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node scripts/post-install.mjs",
    "build": "turbo run build --filter=!./packages/docs/* --filter=!./packages/debug-apps/*",
    "build:react": "turbo run build --filter=!./packages/docs/* --filter=!./packages/debug-apps/* --filter=!./packages/frameworks/angular*",
    "build:docs": "turbo run build --filter=./packages/docs/*",
    "dev": "turbo run dev --filter=!./packages/docs/* --filter=!./packages/debug-apps/*",
    "dev:react": "turbo run dev --filter '@qualcomm-ui/react-internal' --filter '@qualcomm-ui/react-swagger*...' --filter '@qualcomm-ui/react-router-utils' --filter '@qualcomm-ui/react-mdx*...' --filter '@qualcomm-ui/mdx-vite*...'",
    "dev:angular": "turbo run dev --filter=@qualcomm-ui/angular-core --filter=@qualcomm-ui/angular",
    "build:typedoc:ci": "turbo run build:typedoc --filter=$PACKAGE_NAME",
    "generate-knowledge": "pnpm -r generate-knowledge",
    "angular": "pnpm -C packages/frameworks/angular",
    "angular-core": "pnpm -C packages/frameworks/angular-core",
    "react": "pnpm -C packages/frameworks/react",
    "react-core": "pnpm -C packages/frameworks/react-core",
    "angular-docs": "pnpm -C packages/docs/angular-docs",
    "angular-table-docs": "pnpm -C packages/docs/angular-table-docs",
    "qui-docs": "pnpm -C packages/docs/qui-docs",
    "react-docs": "pnpm -C packages/docs/react-docs",
    "react-internal": "pnpm -C packages/frameworks/react-internal",
    "react-mdx": "pnpm -C packages/frameworks/react-mdx",
    "react-table-docs": "pnpm -C packages/docs/react-table-docs",
    "react-test-utils": "pnpm -C packages/frameworks/react-test-utils",
    "core": "pnpm -C packages/common/core",
    "dom": "pnpm -C packages/common/dom",
    "mdx-vite": "pnpm -C packages/common/mdx-vite",
    "node-utils": "pnpm -C packages/common/node-utils",
    "qds-core": "pnpm -C packages/common/qds-core",
    "tailwind-plugin": "pnpm -C packages/common/tailwind-plugin",
    "utils": "pnpm -C packages/common/utils",
    "angular-ssr": "pnpm -C packages/debug-apps/angular-ssr",
    "angular-csr": "pnpm -C packages/debug-apps/angular-csr",
    "react-ssr": "pnpm -C packages/debug-apps/react-ssr",
    "eslint-plugin-angular": "pnpm -C packages/configs/eslint-plugin-angular",
    "eslint-plugin-react": "pnpm -C packages/configs/eslint-plugin-react",
    "react-swagger": "pnpm -C packages/frameworks/react-swagger",
    "test": "turbo run test",
    "lint": "turbo run lint --continue",
    "lint:ci": "turbo run lint --concurrency 6",
    "test:unit:ci": "turbo run test:unit:ci --concurrency 2",
    "check-updates": "ncu -c 2 -w",
    "doc-gen": "turbo run build:typedoc",
    "publish:all": "run-s changeset-publish publish-angular",
    "publish-angular": "pnpm -r run publish-angular-package",
    "changeset-publish": "pnpm changeset publish",
    "changeset-generate": "node --import=tsx scripts/changeset-conventional-commits/main.ts",
    "prep-release": "node --import=tsx scripts/changeset-conventional-commits/cli.ts --include-commit-links",
    "prep-release-from-tags": "pnpm prep-release --from-release-tags"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@changesets/get-github-info": "^0.6.0",
    "@changesets/read": "^0.6.5",
    "@changesets/types": "^6.1.0",
    "@changesets/write": "^0.4.0",
    "@clack/prompts": "1.0.0-alpha.6",
    "@commander-js/extra-typings": "^14.0.0",
    "@eslint/js": "catalog:",
    "@manypkg/get-packages": "^3.1.0",
    "@octokit/rest": "^22.0.1",
    "@qualcomm-ui/eslint-config-angular": "workspace:*",
    "@qualcomm-ui/eslint-config-mdx": "workspace:*",
    "@qualcomm-ui/eslint-config-react": "workspace:*",
    "@qualcomm-ui/eslint-config-typescript": "workspace:*",
    "@qualcomm-ui/eslint-plugin-angular": "workspace:*",
    "@qualcomm-ui/eslint-plugin-path-alias": "workspace:*",
    "@qualcomm-ui/eslint-plugin-react": "workspace:*",
    "@qualcomm-ui/tailwind-plugin": "workspace:*",
    "@types/node": "~24.9.2",
    "browserslist": "^4.28.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "eslint": "catalog:",
    "execa": "^9.6.0",
    "glob": "catalog:",
    "ignore": "^7.0.5",
    "npm-check-updates": "^19.6.3",
    "npm-run-all2": "^8.0.4",
    "playwright": "1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "pretty-ms": "^9.3.0",
    "shx": "^0.4.0",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "syncpack": "14.0.0-alpha.32",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "turbo": "^2.7.6",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "^2.8.2"
  },
  "resolutions": {
    "eslint": "catalog:",
    "lodash": "4.17.23",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
