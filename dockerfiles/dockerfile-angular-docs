FROM public.ecr.aws/docker/library/node:lts-slim AS build

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# lsof and curl are used by build:prod to manage the local crawl server.
RUN set -ex; \
   apt-get update; \
   apt-get install -y --no-install-recommends git lsof curl wget; \
   rm -rf /var/lib/apt/lists/*

RUN npm i -g corepack
RUN corepack enable

COPY . .

# The build needs the full dependency tree; only the final stage is prod-only.
RUN pnpm install --frozen-lockfile

RUN pnpm exec playwright install chromium --with-deps --only-shell

RUN pnpm run build
RUN pnpm angular-docs build:prod

# Copies the site with only its production dependencies. Workspace packages are
# copied in rather than symlinked, so the output does not depend on the monorepo.
RUN pnpm --filter @qualcomm-ui/angular-docs deploy --prod /deploy

FROM public.ecr.aws/docker/library/node:lts-slim

WORKDIR /app

ENV NODE_ENV=production

COPY --from=build /deploy/package.json ./
COPY --from=build /deploy/node_modules ./node_modules
COPY --from=build /deploy/build ./build

USER node

EXPOSE 3000

CMD ["node_modules/.bin/react-router-serve", "./build/server/index.js"]
