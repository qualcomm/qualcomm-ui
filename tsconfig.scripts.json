{
  "compilerOptions": {
    "esModuleInterop": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "ES2022",
    "verbatimModuleSyntax": false
  },
  "include": ["./scripts", "*.ts"],
}
